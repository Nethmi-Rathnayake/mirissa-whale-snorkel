# Note: the Web3Forms access key that sends the agency's booking notification
# is NOT an env var — it lives in app/components/BookingForm.tsx and is meant
# to be public. Web3Forms' free-tier API rejects server-to-server submissions
# ("Use our API in client side..."), so that call has to run in the browser,
# and Web3Forms' security model relies on the key being client-visible rather
# than secret.

# Gmail account used to send the customer's booking-confirmation email
# (app/api/booking/route.ts, server-side only).
# GMAIL_USER is the sending address (e.g. mirissawhalesnorkal@gmail.com).
# GMAIL_APP_PASSWORD is a 16-character App Password, NOT the regular account password.
# Generate one at https://myaccount.google.com/apppasswords (requires 2-Step Verification enabled).
GMAIL_USER=
GMAIL_APP_PASSWORD=

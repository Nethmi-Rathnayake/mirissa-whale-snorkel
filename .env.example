# Gmail account used to send ALL site emails: customer booking confirmation,
# agency booking notification and contact-form messages
# (app/api/booking/route.ts and app/api/contact/route.ts, server-side only).
# GMAIL_USER is the sending address (e.g. mirissawhalesnorkal@gmail.com).
# GMAIL_APP_PASSWORD is a 16-character App Password, NOT the regular account password.
# Generate one at https://myaccount.google.com/apppasswords (requires 2-Step Verification enabled).
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Telegram bot used to notify the agency of new bookings
# (app/api/booking/route.ts, server-side only).
# TELEGRAM_BOT_TOKEN comes from @BotFather on Telegram.
# TELEGRAM_CHAT_ID is the chat/user id that should receive the notification.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Cloudinary account that hosts /public/videos/*.mp4 (videos are uploaded there
# and referenced by their res.cloudinary.com URL directly in component/data
# code — see scripts/upload-videos-to-cloudinary.js). Not read by the running
# app itself, only by that one-off/re-run upload script.
# Find these on the Cloudinary dashboard (console.cloudinary.com) or under
# Settings -> Access Keys.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
